diff --git a/src/Lean/Shell.lean b/src/Lean/Shell.lean
index eda810d0d6..f5a09bdf0f 100644
--- a/src/Lean/Shell.lean
+++ b/src/Lean/Shell.lean
@@ -40,6 +40,64 @@ Before calling this function, the LLVM subsystem must first be successfully init
 @[extern "lean_emit_llvm"]
 opaque emitLLVM (env : Environment) (modName : Name) (filepath : FilePath) : IO Unit
 
+/-! ## Entry points for a host that keeps one Lean alive
+
+A browser worker cannot afford to start `lean` once per input. It boots Lean once
+(`lean_wasm_boot` in `shell.cpp`), optionally loads an `--incr-header-save` snapshot, and then
+checks many inputs. Environments are kept per header, so only the first input with a given
+header pays for its imports.
+-/
+
+/-- Imported environments by header: the imported module names, and whether the file is a `module`. -/
+builtin_initialize wasmEnvCache :
+    IO.Ref (Array ((Array Name × Bool) × Environment)) ← IO.mkRef #[]
+
+def wasmEnvFor (header : Elab.HeaderSyntax) : IO Environment := do
+  let imports := header.imports
+  let key := (imports.map (·.module), header.isModule)
+  if let some (_, env) := (← wasmEnvCache.get).find? (·.1 == key) then
+    return env
+  -- `withImporting` (inside `importModules`) clears the flag on return
+  unsafe enableInitializersExecution
+  -- The environment outlives this call, so its regions must not be freed (`leakEnv`).
+  let env ← importModules imports {} 0 (loadExts := true) (leakEnv := true)
+    (level := if header.isModule then .exported else .private)
+  wasmEnvCache.modify (·.push (key, env))
+  return env
+
+/--
+Adds the environment of the `--incr-header-save` snapshot at `path` to the cache, so that inputs
+with the same header skip the import. Returns 0 on success and 1 on failure.
+-/
+@[export lean_wasm_load_snapshot]
+def wasmLoadSnapshot (path : String) : IO UInt32 := do
+  try
+    let env ← unsafe Elab.loadHeaderSnapshotEnv ⟨path⟩
+    wasmEnvCache.modify (·.push ((env.header.imports.map (·.module), env.header.isModule), env))
+    return 0
+  catch e =>
+    IO.eprintln s!"loading snapshot {path} failed: {e}"
+    return 1
+
+/--
+Elaborates `code` (a whole file, header included) and prints its messages to stdout, one JSON
+object per line, in the format of `lean --json`. `fileName` only labels the messages and names
+the main module. Returns 0 if there were no errors and 1 otherwise.
+-/
+@[export lean_wasm_check]
+def wasmCheck (code fileName : String) : IO UInt32 := do
+  let inputCtx := Parser.mkInputContext code fileName
+  let (header, parserState, headerMessages) ← Parser.parseHeader inputCtx
+  let mainModule := match (System.FilePath.mk fileName).fileStem with
+    | some stem => Name.mkSimple stem
+    | none => `_stdin
+  let env := (← wasmEnvFor header).setMainModule mainModule
+  let s ← Elab.IO.processCommands inputCtx parserState (Elab.Command.mkState env {} {})
+  let msgs := headerMessages ++ s.commandState.messages
+  for msg in msgs.toList do
+    IO.println (← msg.toJson).compress
+  return if msgs.hasErrors then 1 else 0
+
 /-- Whether Lean was built with an address sanitizer enabled. -/
 @[extern "lean_internal_has_address_sanitizer"]
 opaque Internal.hasAddressSanitizer (_ : Unit) : Bool
