+#ifdef LEAN_EMSCRIPTEN
+// Entry points for a host that keeps one Lean alive and checks many inputs, such as a browser
+// worker. The host never runs `main`: it calls `lean_wasm_boot` once, then the other two.
+// The Lean side is in `src/Lean/Shell.lean`.
+extern "C" obj_res lean_wasm_load_snapshot(obj_arg path);
+extern "C" obj_res lean_wasm_check(obj_arg code, obj_arg file_name);
+extern "C" void emscripten_runtime_keepalive_push(void);
+
+// Runs `f` on a thread with Lean's stack size, as `lean_main` does. Returns 2 if it throws.
+template<class F> static int wasm_run(F && f) {
+    int rc = 2;
+    run_with_thread_stack([&]() {
+        try {
+            rc = get_io_uint32_result(f());
+        } catch (lean::throwable & ex) {
+            std::cerr << ex.what() << std::endl;
+        } catch (std::bad_alloc & ex) {
+            std::cerr << "out of memory" << std::endl;
+        }
+    });
+    return rc;
+}
+
+/* Initializes Lean and starts `num_threads` task-manager threads. Returns 0 on success. */
+extern "C" LEAN_EXPORT int lean_wasm_boot(unsigned num_threads) {
+    if (__llvm_profile_set_filename) {
+        __llvm_profile_set_filename("/dev/null");
+    }
+    // `lean.js` is linked with `EXIT_RUNTIME=1` for the command line. Without this, the runtime
+    // would exit, and close stdout, the first time the host's event loop runs dry.
+    emscripten_runtime_keepalive_push();
+    new lean::initializer();  // lives as long as the page
+    try {
+        init_search_path();
+    } catch (lean::throwable & ex) {
+        std::cerr << "error: " << ex.what() << std::endl;
+        return 1;
+    }
+    lean_enable_initializer_execution();
+    lean::io_mark_end_initialization();
+    lean_init_task_manager_using(num_threads);
+    return 0;
+}
+
+/* Loads an `--incr-header-save` snapshot. Returns 0 on success. */
+extern "C" LEAN_EXPORT int lean_wasm_load_snapshot_file(char const * path) {
+    return wasm_run([&]() { return lean_wasm_load_snapshot(lean_mk_string(path)); });
+}
+
+/* Checks a whole Lean file given as text; messages go to stdout as JSON lines.
+   Returns 0 if there were no errors, 1 if there were, 2 if the check itself failed. */
+extern "C" LEAN_EXPORT int lean_wasm_check_source(char const * code, char const * file_name) {
+    return wasm_run([&]() { return lean_wasm_check(lean_mk_string(code), lean_mk_string(file_name)); });
+}
