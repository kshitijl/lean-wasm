+
+/* Starts Lean's language server (one file worker) on a thread of its own. Returns 0 on success.
+   The host then talks LSP to it with the two functions below. */
+extern "C" LEAN_EXPORT int lean_wasm_lsp_start_server() {
+    return wasm_run([&]() { return lean_wasm_lsp_start(lean_box(0)); });
+}
+
+/* Hands one LSP message, `Content-Length` header included, to the server. Returns 0 on success.
+   Shallow, so it runs on the caller's stack. */
+extern "C" LEAN_EXPORT int lean_wasm_lsp_send_message(char const * msg) {
+    try {
+        return get_io_uint32_result(lean_wasm_lsp_send(lean_mk_string(msg)));
+    } catch (lean::throwable & ex) {
+        std::cerr << ex.what() << std::endl;
+        return 2;
+    }
+}
+
+/* Returns what the server wrote since the last call, possibly "", as a string that the caller
+   must `free`. Does not wait. */
+extern "C" LEAN_EXPORT char * lean_wasm_lsp_receive() {
+    object * r = lean_wasm_lsp_recv(lean_box(0));
+    if (io_result_is_error(r)) {
+        dec(r);
+        return strdup("");
+    }
+    char * out = strdup(lean_string_cstr(io_result_get_value(r)));
+    dec(r);
+    return out;
+}
