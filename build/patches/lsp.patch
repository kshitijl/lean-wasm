+/-! ## Lean's language server, in the same process
+
+Normally the watchdog starts one `lean --worker` process per open file and talks LSP to it over
+stdin and stdout. A browser cannot start processes. So the host starts the file worker on a
+thread of its own (`lean_wasm_lsp_start`) and exchanges LSP messages with it through two
+channels: `lean_wasm_lsp_send` hands it one message, `lean_wasm_lsp_recv` collects what it wrote.
+The worker serves one document for the life of the page.
+-/
+
+structure WasmLsp where
+  /-- Bytes from the host to the worker. -/
+  toWorker : Std.Channel.Sync ByteArray
+  /-- Bytes the worker wrote, for the host. -/
+  fromWorker : Std.Channel.Sync ByteArray
+
+builtin_initialize wasmLsp : IO.Ref (Option WasmLsp) ← IO.mkRef none
+
+def findNewline (b : ByteArray) : Option Nat := Id.run do
+  for i in [0:b.size] do
+    if b[i]! == 10 then
+      return some i
+  return none
+
+/-- Reads one line, waiting for the host to send more bytes when needed. -/
+partial def wasmLspGetLine (buf : IO.Ref ByteArray) (input : Std.Channel.Sync ByteArray) :
+    IO String := do
+  let b ← buf.get
+  match findNewline b with
+  | some i =>
+    buf.set (b.extract (i + 1) b.size)
+    return (String.fromUTF8? (b.extract 0 (i + 1))).getD ""
+  | none =>
+    let more ← input.recv
+    buf.set (b ++ more)
+    wasmLspGetLine buf input
+
+/-- Reads exactly `n` bytes, waiting for the host to send more when needed. -/
+partial def wasmLspRead (buf : IO.Ref ByteArray) (input : Std.Channel.Sync ByteArray)
+    (n : Nat) : IO ByteArray := do
+  let b ← buf.get
+  if b.size >= n then
+    buf.set (b.extract n b.size)
+    return b.extract 0 n
+  else
+    let more ← input.recv
+    buf.set (b ++ more)
+    wasmLspRead buf input n
+
+/--
+Starts Lean's file worker on a thread of its own. The host then sends it `initialize` and
+`textDocument/didOpen`, as an editor would. Returns 0 on success, 1 if it was already started.
+-/
+@[export lean_wasm_lsp_start]
+def wasmLspStart (_ : Unit) : IO UInt32 := do
+  if (← wasmLsp.get).isSome then
+    return 1
+  let toWorker ← Std.Channel.Sync.new
+  let fromWorker ← Std.Channel.Sync.new
+  wasmLsp.set (some { toWorker, fromWorker })
+  let buf ← IO.mkRef ByteArray.empty
+  let stream : IO.FS.Stream := {
+    flush := pure ()
+    read := fun n => wasmLspRead buf toWorker n.toNat
+    write := fun b => fromWorker.send b
+    getLine := wasmLspGetLine buf toWorker
+    putStr := fun s => fromWorker.send s.toUTF8
+    isTty := pure false
+  }
+  let err ← IO.getStderr
+  let _ ← IO.asTask (prio := .dedicated) do
+    try
+      Server.FileWorker.initAndRunWorker stream stream err {}
+    catch e =>
+      IO.eprintln s!"language server stopped: {e}"
+  return 0
+
+/-- Hands one LSP message (with its `Content-Length` header) to the worker. -/
+@[export lean_wasm_lsp_send]
+def wasmLspSend (msg : String) : IO UInt32 := do
+  let some lsp ← wasmLsp.get
+    | return 1
+  lsp.toWorker.send msg.toUTF8
+  return 0
+
+/-- Everything the worker wrote since the last call, or the empty string. Does not wait. -/
+@[export lean_wasm_lsp_recv]
+partial def wasmLspRecv (_ : Unit) : IO String := do
+  let some lsp ← wasmLsp.get
+    | return ""
+  let rec drain (acc : ByteArray) : IO ByteArray := do
+    match ← lsp.fromWorker.tryRecv with
+    | some b => drain (acc ++ b)
+    | none => return acc
+  return (String.fromUTF8? (← drain .empty)).getD ""
+
